# Política de dependencias (OpenSSF, cadena de suministro).
# ignore-scripts: ningún paquete ejecuta preinstall/postinstall al instalarse,
#   que es la vía habitual del malware en npm. Los hooks de git se instalan
#   aparte: `npm start` lo hace, o a mano con `npx --no husky`.
# save-exact: `npm install x` guarda la versión exacta, sin ^ ni ~.
# engine-strict: no instala si la versión de Node no es la del proyecto.
ignore-scripts=true
save-exact=true
engine-strict=true
fund=false
