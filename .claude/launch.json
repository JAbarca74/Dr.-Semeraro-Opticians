{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../optica-semeraro-api",
        "run",
        "start:dev"
      ],
      "port": 3000
    },
    {
      "name": "api-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../optica-semeraro-api",
        "run",
        "start:dev:local"
      ],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4173"
      ],
      "port": 4173
    }
  ]
}
