{
  "name": "optica-semeraro-frontend",
  "version": "0.1.0",
  "description": "Frontend del Sistema de Gestion de Optica Dr. Semeraro (React + Vite)",
  "author": "Grupo 84 - Ingenieria de Sistemas I - UNA",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "start": "node scripts/arrancar.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "seguridad:secretos": "node scripts/escanear-secretos.mjs",
    "seguridad:lockfile": "lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --validate-https --validate-package-names --validate-integrity",
    "lint": "eslint . --ext ts,tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*": "node scripts/escanear-secretos.mjs"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "framer-motion": "13.5.1",
    "jwt-decode": "^4.0.0",
    "lucide-react": "1.47.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "lockfile-lint": "5.1.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.4",
    "vite": "^8.3.0",
    "vitest": "5.0.5"
  }
}
